{
  "name": "crossword-journey",
  "version": "1.0.0",
  "description": "Crossword Journey — solve clue-driven intersecting words across a travel journal of scenic dioramas, on the StarHermit engine.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.mjs tests/content.test.mjs tests/save.test.mjs tests/i18n.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-play.mjs",
    "start": "node server.js",
    "smoke": "node tools/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  },
