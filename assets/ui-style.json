{
  "styles": {
    ".ink": {
      "text": {
        "color": "$ink",
        "size": 16
      }
    },
    ".ink-b": {
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "600"
      }
    },
    ".muted": {
      "text": {
        "color": "$muted",
        "size": 16
      }
    },
    ".small": {
      "text": {
        "color": "$muted",
        "size": 13.6
      }
    },
    ".brand": {
      "text": {
        "color": "$accent",
        "size": 18.4,
        "weight": "700"
      }
    },
    ".status": {
      "text": {
        "color": "$muted",
        "size": 14.4
      }
    },
    ".screen-heading": {
      "background": "#10151f9e",
      "radius": 12,
      "padding": {
        "top": 4,
        "end": 16,
        "bottom": 4,
        "start": 16
      },
      "text": {
        "color": "$paper",
        "size": 25.6,
        "weight": "700",
        "shadow": {
          "y": 1,
          "blur": 10,
          "color": "#0a0e16a6"
        }
      }
    },
    ".lede": {
      "background": "#10151f9e",
      "radius": 12,
      "padding": {
        "top": 4,
        "end": 16,
        "bottom": 4,
        "start": 16
      },
      "text": {
        "color": "#e6ebf2",
        "size": 16,
        "shadow": {
          "y": 1,
          "blur": 8,
          "color": "#0a0e1699"
        }
      }
    },
    ".rail-heading": {
      "text": {
        "color": "$muted",
        "size": 13.6,
        "weight": "700",
        "letterSpacing": 0.8
      }
    },
    ".objective": {
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "600"
      }
    },
    ".hud": {
      "text": {
        "color": "$ink",
        "size": 16
      }
    },
    ".hud-score": {
      "text": {
        "color": "$accent",
        "size": 16,
        "weight": "800"
      }
    },
    ".clue-dir": {
      "text": {
        "color": "$muted",
        "size": 12.8,
        "weight": "700"
      }
    },
    ".current-clue": {
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "600"
      }
    },
    ".board-clue": {
      "background": "#fffdf7d9",
      "radius": 10,
      "padding": {
        "top": 4,
        "end": 12,
        "bottom": 4,
        "start": 12
      },
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "600"
      }
    },
    ".results-headline": {
      "text": {
        "color": "$accent",
        "size": 24,
        "weight": "800"
      }
    },
    ".bd-label": {
      "text": {
        "color": "$muted",
        "size": 16
      }
    },
    ".bd-value": {
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "700"
      }
    },
    ".bd-total": {
      "text": {
        "color": "$ink",
        "size": 18.4,
        "weight": "700"
      }
    },
    ".meta": {
      "text": {
        "color": "$muted",
        "size": 14.4
      }
    },
    ".help-title": {
      "text": {
        "color": "$accent",
        "size": 16,
        "weight": "700"
      }
    },
    ".help-text": {
      "text": {
        "color": "$ink",
        "size": 14.4
      }
    },
    ".legend": {
      "background": "$accent",
      "radius": 8,
      "padding": {
        "top": 2,
        "end": 10,
        "bottom": 2,
        "start": 10
      },
      "text": {
        "color": "$paper",
        "size": 16,
        "weight": "700"
      }
    },
    ".pause-title": {
      "text": {
        "color": "$accent",
        "size": 24,
        "weight": "700"
      }
    },
    ".chip": {
      "background": "$tile",
      "border": {
        "width": 2,
        "color": "$tile-edge",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 8,
        "end": 14,
        "bottom": 8,
        "start": 14
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$ink",
        "size": 15.2,
        "weight": "600",
        "align": "center"
      },
      "hovered": {
        "border": {
          "color": "$accent"
        }
      }
    },
    ".big": {
      "background": "$accent",
      "radius": 14,
      "shadow": {
        "y": 4,
        "blur": 14,
        "color": "#00000059"
      },
      "padding": {
        "top": 12,
        "end": 28,
        "bottom": 12,
        "start": 28
      },
      "minWidth": 160,
      "minHeight": 56,
      "text": {
        "color": "#ffffff",
        "size": 20,
        "weight": "800",
        "align": "center"
      },
      "hovered": {
        "background": [
          {
            "type": "linear",
            "stops": ["#ffffff14", "#ffffff14"]
          },
          "$accent"
        ]
      }
    },
    ".card": {
      "background": "$panel",
      "border": {
        "width": 2,
        "color": "$tile-edge",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 12,
        "end": 16,
        "bottom": 12,
        "start": 16
      },
      "minWidth": 200,
      "minHeight": 64,
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "700",
        "align": "start"
      },
      "hovered": {
        "border": {
          "color": "$accent"
        }
      }
    },
    ".card-sub": {
      "text": {
        "color": "$muted",
        "size": 13.6
      }
    },
    ".mode-item": {
      "background": "$panel",
      "border": {
        "width": 2,
        "color": "$tile-edge",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 14,
        "end": 16,
        "bottom": 14,
        "start": 16
      },
      "minHeight": 44,
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "700",
        "align": "start"
      },
      "hovered": {
        "border": {
          "color": "$accent"
        }
      },
      "disabled": {
        "background": "#fffdf78c",
        "text": {
          "color": "#26313d8c"
        }
      }
    },
    ".mode-desc": {
      "text": {
        "color": "$muted",
        "size": 14.4
      }
    },
    ".mode-meta": {
      "text": {
        "color": "$accent",
        "size": 12.8,
        "weight": "700"
      }
    },
    ".mode-stars": {
      "text": {
        "color": "$accent",
        "size": 16
      }
    },
    ".clue": {
      "background": "#00000000",
      "border": {
        "width": 2,
        "color": "#00000000",
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 8,
        "end": 10,
        "bottom": 8,
        "start": 10
      },
      "minHeight": 44,
      "text": {
        "color": "$ink",
        "size": 14.7,
        "weight": "400",
        "align": "start"
      },
      "hovered": {
        "background": "#0000000d"
      },
      "selected": {
        "background": "#2f80ed1f",
        "border": {
          "color": "$select"
        }
      }
    },
    ".clue-done": {
      "text": {
        "color": "$muted"
      }
    },
    ".clue-num": {
      "text": {
        "color": "$ink",
        "size": 14.7,
        "weight": "800"
      }
    },
    ".act": {
      "background": "$accent",
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 14,
        "bottom": 10,
        "start": 14
      },
      "minHeight": 44,
      "text": {
        "color": "#ffffff",
        "size": 15.2,
        "weight": "700",
        "align": "center"
      },
      "hovered": {
        "background": [
          {
            "type": "linear",
            "stops": ["#ffffff14", "#ffffff14"]
          },
          "$accent"
        ]
      },
      "selected": {
        "background": [
          {
            "type": "linear",
            "stops": ["#0000002e", "#0000002e"]
          },
          "$accent"
        ]
      },
      "disabled": {
        "background": "#d96c4780"
      }
    },
    ".danger": {
      "background": "$wrong",
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 14,
        "bottom": 10,
        "start": 14
      },
      "minHeight": 44,
      "text": {
        "color": "#ffffff",
        "size": 15.2,
        "weight": "700",
        "align": "center"
      }
    },
    ".osk-key": {
      "background": "$paper",
      "border": {
        "width": 1,
        "color": "$tile-edge",
        "style": "solid"
      },
      "radius": 6,
      "padding": 0,
      "minHeight": 40,
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "700",
        "align": "center"
      },
      "pressed": {
        "background": "$accent"
      }
    },
    ".toggle-btn": {
      "background": "$panel",
      "border": {
        "width": 2,
        "color": "$tile-edge",
        "style": "solid"
      },
      "radius": 10,
      "padding": 8,
      "minHeight": 44,
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "700",
        "align": "center"
      }
    },
    ".topbar": {
      "background": "$panel",
      "shadow": {
        "y": 1,
        "blur": 6,
        "color": "#00000040"
      },
      "padding": {
        "top": 6,
        "end": 14,
        "bottom": 6,
        "start": 14
      }
    },
    ".rail-block": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "#00000014",
        "style": "solid"
      },
      "radius": 12,
      "padding": 14
    },
    ".d-rail-block": {
      "shadow": {
        "y": 6,
        "blur": 18,
        "color": "#0a0e1638"
      }
    },
    ".tray": {
      "background": "$panel",
      "shadow": {
        "y": -2,
        "blur": 10,
        "color": "#0000004d"
      },
      "padding": {
        "top": 8,
        "end": 10,
        "bottom": 8,
        "start": 10
      }
    },
    ".banner": {
      "background": "$panel",
      "border": {
        "width": {
          "start": 5
        },
        "color": {
          "start": "$accent"
        },
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 12,
        "end": 16,
        "bottom": 12,
        "start": 16
      },
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "600"
      }
    },
    ".results-card": {
      "background": "$panel",
      "radius": 14,
      "padding": {
        "top": 20,
        "end": 24,
        "bottom": 20,
        "start": 24
      }
    },
    ".d-results-card": {
      "shadow": {
        "y": 6,
        "blur": 18,
        "color": "#0a0e1638"
      }
    },
    ".d-card": {
      "shadow": {
        "y": 6,
        "blur": 18,
        "color": "#0a0e1638"
      }
    },
    ".help-card": {
      "background": "$panel",
      "radius": 12,
      "padding": {
        "top": 14,
        "end": 16,
        "bottom": 14,
        "start": 16
      }
    },
    ".fieldset": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$tile-edge",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 12,
        "end": 16,
        "bottom": 12,
        "start": 16
      }
    },
    ".overlay-card": {
      "background": "$panel",
      "radius": 16,
      "padding": 26
    },
    ".toast": {
      "background": "$ink",
      "radius": 10,
      "shadow": {
        "y": 4,
        "blur": 14,
        "color": "#00000066"
      },
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
      },
      "text": {
        "color": "$paper",
        "size": 16,
        "weight": "600"
      }
    },
    ".achievement": {
      "background": "$accent",
      "radius": 999,
      "padding": {
        "top": 6,
        "end": 14,
        "bottom": 6,
        "start": 14
      },
      "text": {
        "color": "#ffffff",
        "size": 13.6,
        "weight": "700"
      }
    },
    ".kbd": {
      "background": "$ink",
      "radius": 6,
      "padding": {
        "top": 2,
        "end": 8,
        "bottom": 2,
        "start": 8
      },
      "text": {
        "color": "$paper",
        "size": 14.4,
        "weight": "700"
      }
    },
    ".art": {
      "radius": 14,
      "shadow": {
        "y": 8,
        "blur": 24,
        "color": "#00000073"
      }
    },
    ".results-art": {
      "radius": 10
    },
    ".rule": {
      "background": "$tile-edge"
    }
  },
  "animations": {},
  "tokens": {
    "accent": "#d96c47",
    "bg": "#10151f",
    "ink": "#26313d",
    "muted": "#5b6472",
    "ok": "#3f9d63",
    "panel": "#fffdf7f5",
    "paper": "#f6efe0",
    "revealed": "#8a6fd0",
    "select": "#2f80ed",
    "tile": "#fdfaf1",
    "tile-edge": "#d9cfae",
    "white": "#ffffff",
    "wrong": "#c0392b"
  },
  "layouts": {},
  "dropped": []
}
